# Copia este archivo como .env (NO lo subas a git) y ajusta los valores
# En IntelliJ: Run/Debug Configurations -> Environment Variables, pega estas claves

SERVER_PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/ridemove
DB_USER=ridemove_user
DB_PASSWORD=cambia_esta_clave

JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-caracteres
JWT_EXPIRATION_MS=3600000

LOG_LEVEL=INFO
